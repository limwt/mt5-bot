# ---- MT5 계좌 (Infinox 데모) ----
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=INFINOX-Demo
# MT5 터미널이 여러 개 설치돼 있으면 Infinox 터미널 경로를 지정 (선택)
MT5_PATH=

# 실계정 접속 허용 여부. 데모 검증 끝나기 전엔 절대 true로 바꾸지 말 것
ALLOW_LIVE=false

# ---- 매매 설정 ----
SYMBOL=EURUSD
TIMEFRAME=M15
LOT=0.01
SL_POINTS=200
TP_POINTS=400
FAST_MA=10
SLOW_MA=30
MAGIC=20261121
POLL_SECONDS=10

# ---- 리스크 한도 ----
MAX_POSITIONS=1
# 계좌 통화 기준 하루 최대 손실 (실현+미실현). 넘으면 신규 진입 중지
DAILY_LOSS_LIMIT=50

# ---- 텔레그램 (비워두면 텔레그램 없이 동작) ----
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
